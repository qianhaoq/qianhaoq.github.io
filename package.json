{
  "name": "qianhaoq.github.io",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "lint": "eslint . --max-warnings=0",
    "check": "astro check",
    "unit": "vitest run",
    "unit:report": "vitest run --reporter=json --outputFile=.test-results/unit-results.json",
    "unit:gate": "rm -rf .test-results; pnpm unit:report || true; tsx scripts/check-unit-pass-rate.ts .test-results/unit-results.json 90",
    "bdd": "cucumber-js --config cucumber.mjs",
    "quality": "pnpm lint && pnpm check && pnpm unit:gate && pnpm build && pnpm bdd",
    "author": "tsx scripts/author.ts",
    "write": "tsx scripts/write-post.ts",
    "new:post": "tsx scripts/new-post.ts",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.4",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cucumber/cucumber": "^13.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "cheerio": "^1.2.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
